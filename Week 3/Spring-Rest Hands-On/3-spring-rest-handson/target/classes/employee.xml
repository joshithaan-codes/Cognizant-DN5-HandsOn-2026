<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       https://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ==================== SKILLS ==================== -->

    <bean id="skillJava"
          class="com.cognizant._springresthandson.model.Skill">
        <property name="id" value="1"/>
        <property name="name" value="Java"/>
    </bean>

    <bean id="skillSpring"
          class="com.cognizant._springresthandson.model.Skill">
        <property name="id" value="2"/>
        <property name="name" value="Spring"/>
    </bean>

    <bean id="skillSql"
          class="com.cognizant._springresthandson.model.Skill">
        <property name="id" value="3"/>
        <property name="name" value="SQL"/>
    </bean>


    <!-- ==================== DEPARTMENTS ==================== -->

    <bean id="departmentIT"
          class="com.cognizant._springresthandson.model.Department">
        <property name="id" value="1"/>
        <property name="name" value="IT"/>
    </bean>

    <bean id="departmentHR"
          class="com.cognizant._springresthandson.model.Department">
        <property name="id" value="2"/>
        <property name="name" value="HR"/>
    </bean>

    <bean id="departmentFinance"
          class="com.cognizant._springresthandson.model.Department">
        <property name="id" value="3"/>
        <property name="name" value="Finance"/>
    </bean>


    <!-- ==================== EMPLOYEES ==================== -->

    <bean id="employee1"
          class="com.cognizant._springresthandson.model.Employee">

        <property name="id" value="1"/>
        <property name="name" value="John"/>
        <property name="salary" value="50000"/>
        <property name="permanent" value="true"/>
        <property name="department" ref="departmentIT"/>

        <property name="skillList">
            <list>
                <ref bean="skillJava"/>
                <ref bean="skillSpring"/>
            </list>
        </property>
    </bean>


    <bean id="employee2"
          class="com.cognizant._springresthandson.model.Employee">

        <property name="id" value="2"/>
        <property name="name" value="David"/>
        <property name="salary" value="45000"/>
        <property name="permanent" value="true"/>
        <property name="department" ref="departmentHR"/>

        <property name="skillList">
            <list>
                <ref bean="skillJava"/>
            </list>
        </property>
    </bean>


    <bean id="employee3"
          class="com.cognizant._springresthandson.model.Employee">

        <property name="id" value="3"/>
        <property name="name" value="Emma"/>
        <property name="salary" value="60000"/>
        <property name="permanent" value="true"/>
        <property name="department" ref="departmentIT"/>

        <property name="skillList">
            <list>
                <ref bean="skillSpring"/>
                <ref bean="skillSql"/>
            </list>
        </property>
    </bean>


    <bean id="employee4"
          class="com.cognizant._springresthandson.model.Employee">

        <property name="id" value="4"/>
        <property name="name" value="Sophia"/>
        <property name="salary" value="55000"/>
        <property name="permanent" value="false"/>
        <property name="department" ref="departmentFinance"/>

        <property name="skillList">
            <list>
                <ref bean="skillSql"/>
            </list>
        </property>
    </bean>


    <bean id="employee5"
          class="com.cognizant._springresthandson.model.Employee">

        <property name="id" value="5"/>
        <property name="name" value="Michael"/>
        <property name="salary" value="65000"/>
        <property name="permanent" value="true"/>
        <property name="department" ref="departmentFinance"/>

        <property name="skillList">
            <list>
                <ref bean="skillJava"/>
                <ref bean="skillSql"/>
            </list>
        </property>
    </bean>


    <!-- ==================== EMPLOYEE LIST ==================== -->

    <bean id="employeeList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="employee1"/>
                <ref bean="employee2"/>
                <ref bean="employee3"/>
                <ref bean="employee4"/>
                <ref bean="employee5"/>
            </list>
        </constructor-arg>
    </bean>


    <!-- ==================== DEPARTMENT LIST ==================== -->

    <bean id="departmentList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="departmentIT"/>
                <ref bean="departmentHR"/>
                <ref bean="departmentFinance"/>
            </list>
        </constructor-arg>
    </bean>

</beans>